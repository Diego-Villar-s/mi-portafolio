<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Portafolio - Ingeniería de Sistemas</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <section id="inicio" class="hero">
            <img src="assets/foto-perfil.jpg" id="foto-perfil" alt="Foto de perfil de Diego Villar">
            <h1>Hola, soy Diego Alejandro Villar Madera</h1>
            <p>Estudiante de Ingeniería de Sistemas</p>
            <button id="btn-ver-mas">Ver más</button>
        </section>

        <section id="proyectos">
            <h2>Mis Proyectos</h2>
            <div class="grid-proyectos">
                <% proyectos.forEach(function(proyecto) { %>
                    <article class="card-proyecto">
                        <img src="<%= proyecto.img %>" alt="<%= proyecto.titulo %>">
                        <h3><%= proyecto.titulo %></h3>
                        <span class="tech"><%= proyecto.tech %></span>
                        <p><%= proyecto.desc %></p>
                    </article>
                <% }); %>
            </div>
        </section>

        <section id="contacto">
            <h2>Contacto</h2>
            <p>Correo: 022100772k@uandina.edu.pe</p>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="script.js"></script>
</body>
</html>
